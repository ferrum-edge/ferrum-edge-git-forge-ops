# Ferrum Edge GitForgeOps — Environment Variables
# For running gitforgeops commands locally.
# In CI, these come from GitHub Environment Secrets (scoped per env) and
# GitHub Environment Variables. See .gitforgeops/config.yaml for logical
# environment definitions.

# --- Environment selection ----------------------------------------------------

# Name of the environment declared in .gitforgeops/config.yaml. When set, this
# also picks the overlay, apply_strategy, and ownership mode from that file.
# Can also be passed as `gitforgeops --env <name> <command>`.
# FERRUM_ENV=staging

# --- Gateway connection (per-environment in CI) ------------------------------

FERRUM_GATEWAY_URL=https://your-gateway:9000
FERRUM_ADMIN_JWT_SECRET=your-32-char-minimum-jwt-secret-here

# Admin API JWT claims. Defaults match a stock gateway; override only if the
# gateway's own FERRUM_ADMIN_JWT_* settings differ.
# `iss` must equal the gateway's FERRUM_ADMIN_JWT_ISSUER or every call is 401.
# FERRUM_ADMIN_JWT_ISSUER=ferrum-edge
# Role claim: viewer | operator | admin. gitforgeops needs `admin` —
# /backup, /restore, /batch and consumer CRUD are all admin-only.
# FERRUM_ADMIN_JWT_ROLE=admin
# `aud` is emitted ONLY when this is set. A gateway with no configured
# audience rejects any token that carries the claim (RFC 7519 §4.1.3).
# FERRUM_ADMIN_JWT_AUDIENCE=
# Token lifetime. Must be within the gateway's FERRUM_ADMIN_JWT_MAX_TTL
# (default 3600; acceptance is max_ttl + 60).
# FERRUM_ADMIN_JWT_TTL_SECS=3600

# TLS (optional — omit for public CA)
# FERRUM_GATEWAY_CA_CERT=<base64-encoded PEM>
# FERRUM_GATEWAY_CLIENT_CERT=<base64-encoded PEM>
# FERRUM_GATEWAY_CLIENT_KEY=<base64-encoded PEM>

# Namespace filter (overrides repo config; omit to process all namespaces).
# FERRUM_NAMESPACE=ferrum

# Gateway mode: api (push via Admin API) or file (assemble flat YAML)
FERRUM_GATEWAY_MODE=api

# Overlay directory override; prefer .gitforgeops/config.yaml + FERRUM_ENV.
# FERRUM_OVERLAY=

# Apply strategy: incremental (CRUD) or full_replace (POST /restore)
# Incompatible with ownership.mode: shared — will error at startup.
# FERRUM_APPLY_STRATEGY=incremental

# Path to ferrum-edge binary (auto-detected on $PATH if unset)
FERRUM_EDGE_BINARY_PATH=ferrum-edge

# File mode output path
# FERRUM_FILE_OUTPUT_PATH=./assembled/resources.yaml

# Output path for the standalone mesh document ({version, mesh}).
# Written by file-mode apply and by `gitforgeops export` whenever the repo
# declares any `kind: MeshConfig` resource under resources/<ns>/mesh/.
# This is a SEPARATE document from FERRUM_FILE_OUTPUT_PATH: a mesh node's
# loader rejects a document carrying proxies:/upstreams:, and the gateway
# ignores a mesh: key. Point a mesh node's FERRUM_MESH_FILE_CONFIG_PATH here.
# FERRUM_MESH_FILE_OUTPUT_PATH=./assembled/mesh.yaml

# Skip TLS verification (dev only!)
# FERRUM_TLS_NO_VERIFY=false

# --- HTTP timeouts + retry (main) --------------------------------------------

# HTTP timeouts for admin-API calls. Raise request timeout for very large
# /backup responses or slow /restore commits. Raise connect timeout if
# the admin API is behind a slow load balancer.
# FERRUM_GATEWAY_CONNECT_TIMEOUT_SECS=10
# FERRUM_GATEWAY_REQUEST_TIMEOUT_SECS=60

# HTTP timeouts for the GitHub API call used by `gitforgeops review --pr N`.
# Defaults are appropriate for GitHub's public API; unlikely to need tuning.
# FERRUM_GITHUB_CONNECT_TIMEOUT_SECS=10
# FERRUM_GITHUB_REQUEST_TIMEOUT_SECS=30

# Max automatic retries on transient admin-API failures (connection errors,
# HTTP 5xx, 429). Retries use exponential backoff (500ms, 1s, 2s, 4s, 8s).
# Set to 0 to disable. Request timeouts are NOT retried (ambiguous state).
# FERRUM_GATEWAY_MAX_RETRIES=3

# --- Credential broker (in-GitHub) -------------------------------------------

# Token with repo `Secrets: write` + `Environments: write` permission, used to
# allocate or rotate consumer credentials. Prefer a short-lived GitHub App
# installation token over a PAT. Without this set, allocation/rotation fails.
# FERRUM_GH_PROVISIONER_TOKEN=

# Inline merged JSON object of FERRUM_CREDS_BUNDLE* env secret values. This is
# handy for small local tests, but bundled CI workflows use FERRUM_CREDS_JSON_FILE
# instead to avoid OS env-size limits.
# Example: {"FERRUM_CREDS_BUNDLE": {"slot":"v"}}
# FERRUM_CREDS_JSON=

# PATH to a file containing the same JSON payload. This is what the bundled
# workflow "Load credential bundles" steps set. When both are set, the file
# path wins.
# FERRUM_CREDS_JSON_FILE=/run/gitforgeops/creds.json

# --- GitHub API (auto-populated in Actions) -----------------------------------

# Read-only token used to check PR override labels/permissions and post review
# comments. Provided automatically by `${{ secrets.GITHUB_TOKEN }}` in CI.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repo

# Set by the bundled workflows, not by hand. GITFORGEOPS_PR_NUMBER routes
# policy-override lookups and credential delivery to the right PR;
# GITFORGEOPS_ACTOR is the GitHub login credentials are age-encrypted to
# (the PR author, falling back to the pusher). GITHUB_SHA / GITHUB_RUN_ID /
# GITHUB_STEP_SUMMARY are the standard Actions variables and are used for
# PR resolution, credential audit metadata, and job summaries.
# GITFORGEOPS_PR_NUMBER=
# GITFORGEOPS_ACTOR=
